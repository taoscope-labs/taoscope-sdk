{
  "name": "@taoscope/sdk",
  "version": "1.0.2",
  "description": "Official SDK for TaoScope - Bittensor Network Explorer API",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "bittensor",
    "tao",
    "blockchain",
    "crypto",
    "api",
    "sdk",
    "taoscope",
    "explorer",
    "validators",
    "subnets",
    "miners",
    "staking",
    "delegation"
  ],
  "author": {
    "name": "TaoScope Team",
    "url": "https://taoscope.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/taoscope-labs/taoscope-sdk.git"
  },
  "homepage": "https://taoscope.com",
  "bugs": {
    "url": "https://github.com/taoscope-labs/taoscope-sdk/issues"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.2",
    "vitest": "^1.0.4"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
